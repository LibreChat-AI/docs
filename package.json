{
  "name": "librechat.ai",
  "version": "1.0.0",
  "description": "librechat.ai",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3333",
    "build": "next build --webpack",
    "postbuild": "node scripts/clean-cache.cjs",
    "start": "next start -p 3333",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "optimize:images": "node scripts/optimize-images.mjs",
    "web-bot-auth:keygen": "node scripts/generate-web-bot-auth-key.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "eslint --cache --max-warnings 0 .",
    "lint:prettier": "prettier --cache --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "prettier": "prettier --cache --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "prepare": "node -e \"process.env.CI||require('child_process').execSync('husky',{stdio:'inherit'})\"",
    "translate": "npx tsx scripts/translate.ts",
    "screenshots": "tsx scripts/screenshots/capture.ts"
  },
  "homepage": "https://www.librechat.ai",
  "dependencies": {
    "@ai-sdk/react": "^3.0.143",
    "@glidejs/glide": "^3.6.0",
    "@hookform/resolvers": "^3.3.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@orama/orama": "3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@supabase/supabase-js": "^2.86.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/og": "^0.6.2",
    "@vidstack/react": "^1.15.6",
    "ace-builds": "^1.43.5",
    "ai": "^6.0.141",
    "ajv": "^8.18.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.1.9",
    "fumadocs-core": "16.10.5",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.10.5",
    "geist": "^1.3.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.378.0",
    "next": "16.2.12",
    "next-sitemap": "^4.2.3",
    "p-limit": "^7.3.0",
    "react": "^19.2.0",
    "react-ace": "^11.0.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.51.4",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-social-icons": "^6.16.0",
    "react-tweet": "^3.2.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.33.3",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "validator": "^13.15.23",
    "web-vitals": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@eslint/js": "^9",
    "@next/bundle-analyzer": "^15.1.4",
    "@next/eslint-plugin-next": "^15",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/validator": "^13.15.10",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-unicorn": "^56",
    "globals": "^15",
    "husky": "^9.0.11",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tsx": "4.22.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.9",
    "webpack": "^5.104.1"
  },
  "optionalDependencies": {
    "crisp-sdk-web": "^1.0.25"
  },
  "pnpm": {
    "overrides": {
      "preact": ">=10.28.2",
      "webpack": ">=5.104.1",
      "diff": ">=5.2.2",
      "minimatch": ">=3.1.4",
      "serialize-javascript": ">=7.0.3"
    }
  },
  "nextBundleAnalysis": {
    "budget": 358400,
    "budgetPercentIncreaseRed": 20,
    "minimumChangeThreshold": 50,
    "showDetails": true
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
